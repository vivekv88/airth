generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id        String   @id @default(uuid())
  title     String
  type      String
  status    String   @default("pending")
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@map("jobs")
}
